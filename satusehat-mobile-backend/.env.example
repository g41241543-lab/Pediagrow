# Salin menjadi .env lalu isi. JANGAN commit .env dan JANGAN taruh secret di aplikasi mobile.

# development | staging | production
SATUSEHAT_ENV=staging

# Dari portal developer SATUSEHAT (Kemenkes) setelah registrasi organisasi/aplikasi
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORGANIZATION_ID=

# Opsional: override URL (default dipilih dari SATUSEHAT_ENV)
# SATUSEHAT_AUTH_URL=https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1
# SATUSEHAT_FHIR_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1

# Kunci sederhana agar hanya aplikasi mobile Anda yang bisa memanggil backend ini
APP_API_KEY=

PORT=3000
